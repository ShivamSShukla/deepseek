const fs = require('fs');
const path = require('path');
const archiver = require('archiver');

// Create distribution folder
const distDir = 'dist';
if (!fs.existsSync(distDir)) {
  fs.mkdirSync(distDir);
}

// Files to exclude from package
const excludePatterns = [
  /^\./,
  /node_modules/,
  /screenshots/,
  /scripts/,
  /\.md$/,
  /\.git/,
  /package.*\.json$/,
  /\.log$/
];

function shouldInclude(file) {
  return !excludePatterns.some(pattern => pattern.test(file));
}

// Create zip archive
const output = fs.createWriteStream(path.join(distDir, 'hyper-scraper-pro.zip'));
const archive = archiver('zip', {
  zlib: { level: 9 }
});

output.on('close', () => {
  console.log(`Package created: ${archive.pointer()} total bytes`);
  console.log('Extension is ready for upload to Chrome Web Store!');
});

archive.on('error', (err) => {
  throw err;
});

archive.pipe(output);

// Add files
const files = [];
function walk(dir) {
  const items = fs.readdirSync(dir);
  items.forEach(item => {
    const fullPath = path.join(dir, item);
    const stat = fs.statSync(fullPath);
    if (stat.isDirectory()) {
      walk(fullPath);
    } else if (shouldInclude(fullPath)) {
      files.push(fullPath);
    }
  });
}

walk('.');
files.forEach(file => {
  const name = file.replace(/^\.\//, '');
  archive.file(file, { name });
});

archive.finalize();