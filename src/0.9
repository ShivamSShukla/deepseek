* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  width: 400px;
  min-height: 500px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.container {
  background: white;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 16px;
  text-align: center;
}

.header h1 {
  font-size: 18px;
  margin-bottom: 8px;
}

.status {
  font-size: 12px;
  opacity: 0.9;
  padding: 4px 8px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  display: inline-block;
}

.mode-selector {
  display: flex;
  background: #f5f5f5;
  padding: 8px;
  gap: 4px;
}

.mode-btn {
  flex: 1;
  padding: 8px 12px;
  border: none;
  background: white;
  border-radius: 6px;
  cursor: pointer;
  font-size: 12px;
  transition: all 0.2s;
}

.mode-btn.active {
  background: #667eea;
  color: white;
  font-weight: bold;
}

.mode-content {
  padding: 16px;
  flex: 1;
}

.hidden {
  display: none !important;
}

.preset-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 16px;
}

.preset {
  padding: 12px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  background: white;
  cursor: pointer;
  transition: all 0.2s;
  font-size: 12px;
}

.preset:hover {
  border-color: #667eea;
  transform: translateY(-2px);
}

.auto-options {
  background: #f8f9fa;
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 16px;
}

.auto-options label {
  display: block;
  margin-bottom: 8px;
  font-size: 13px;
}

.primary-btn {
  width: 100%;
  padding: 14px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  transition: transform 0.2s;
}

.primary-btn:hover {
  transform: translateY(-2px);
}

.performance {
  margin-top: 16px;
  text-align: center;
}

.speedometer {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: #f0f7ff;
  border-radius: 20px;
  font-size: 12px;
}

.speed-value {
  font-weight: bold;
  color: #667eea;
}

.selector-input textarea,
.urls-input textarea {
  width: 100%;
  height: 120px;
  padding: 12px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-family: monospace;
  font-size: 12px;
  resize: vertical;
  margin-bottom: 16px;
}

.advanced-options {
  background: #f8f9fa;
  padding: 16px;
  border-radius: 8px;
}

.option {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.option label {
  flex: 1;
  font-size: 13px;
}

.option select,
.option input[type="range"] {
  flex: 2;
}

.batch-controls {
  margin-top: 16px;
}

.batch-progress {
  margin-top: 16px;
}

.progress-bar {
  height: 8px;
  background: #e0e0e0;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 8px;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  width: 0%;
  transition: width 0.3s;
}

.results-preview {
  padding: 16px;
  border-top: 2px solid #f0f0f0;
}

.table-container {
  max-height: 200px;
  overflow-y: auto;
  margin: 12px 0;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
}

#preview-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}

#preview-table th,
#preview-table td {
  padding: 6px 8px;
  border-bottom: 1px solid #eee;
  text-align: left;
}

#preview-table th {
  background: #f8f9fa;
  font-weight: 600;
}

.export-options {
  display: flex;
  gap: 8px;
  margin: 16px 0;
  flex-wrap: wrap;
}

.export-btn {
  padding: 8px 16px;
  border: 2px solid #667eea;
  background: white;
  color: #667eea;
  border-radius: 6px;
  cursor: pointer;
  font-size: 12px;
  transition: all 0.2s;
}

.export-btn:hover {
  background: #667eea;
  color: white;
}

.stats {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #666;
  margin-top: 12px;
}

.footer {
  padding: 12px 16px;
  background: #f8f9fa;
  display: flex;
  gap: 8px;
  border-top: 1px solid #e0e0e0;
}

.footer button {
  flex: 1;
  padding: 10px;
  border: 1px solid #667eea;
  background: white;
  color: #667eea;
  border-radius: 6px;
  cursor: pointer;
  font-size: 12px;
}

.footer button:hover {
  background: #667eea;
  color: white;
}