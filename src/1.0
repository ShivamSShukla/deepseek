{
  "name": "hyper-scraper-pro",
  "version": "1.0.0",
  "description": "Ultimate web scraping Chrome extension",
  "main": "background/service-worker.js",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,html,css,json}\"",
    "pack": "zip -r hyper-scraper-pro.zip . -x \".*\" -x \"node_modules/*\" -x \"screenshots/*\" -x \"*.md\""
  },
  "keywords": [
    "chrome-extension",
    "web-scraping",
    "data-extraction",
    "automation",
    "productivity"
  ],
  "author": "HyperScraper Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "chokidar": "^3.0.0",
    "archiver": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/hyper-scraper-pro.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/hyper-scraper-pro/issues"
  },
  "homepage": "https://github.com/yourusername/hyper-scraper-pro#readme"
}